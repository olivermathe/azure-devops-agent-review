{
  "name": "azure-devops-kiro-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "review": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {"tsx": "^4.20.0", "typescript": "^5.9.0", "@types/node": "^22.0.0"},
  "engines": {"node": ">=20"}
}
