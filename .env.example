AZDO_ORG=StixFidelidade
AZDO_PROJECT=Projetos
AZDO_TEAM=Nome do Time
AZDO_BOARD=Nome do Board
AZDO_COLUMN=Code Review
AZDO_STATE=Active
AZDO_WORK_ITEM_TYPE=Task,Bug,User Story,Feature
# Quando true, revisa somente repositórios citados no campo livre abaixo
AZDO_FILTER_BY_REPOSITORY_FIELD=false
# Aceita o nome exibido ou reference name, ex.: URL Repository ou Custom.URLRepository
AZDO_REPOSITORY_FIELD=URL Repository
# * permite qualquer destino; uma lista mantém somente PRs para essas branches
AZDO_PR_TARGET_BRANCHES=*
# Nome de referência do campo de coluna deste board/equipe, ex.: WEF_<GUID>_Kanban.Column
AZDO_BOARD_COLUMN_FIELD=
# Opcional: restringir aos itens desta área (e subáreas)
AZDO_AREA_PATH=
AZDO_PAT=
KIRO_API_KEY=
# Opcional: substitui os critérios e o layout padrão do relatório técnico
KIRO_CUSTOM_PROMPT_FILE=
# Notificações opcionais pelo webhook criado no Workflows do Teams
TEAMS_NOTIFICATION_ENABLED=false
TEAMS_WEBHOOK_URL=
# workflow-envelope para o webhook oficial; adaptive-card quando a ação usa o body inteiro
TEAMS_PAYLOAD_FORMAT=workflow-envelope
TEAMS_NOTIFY_ON_SUCCESS=true
TEAMS_NOTIFY_ON_ERROR=true
# true lista o que seria revisado sem clonar nem executar Kiro
DRY_RUN=true
# true ignora o cache e refaz revisões
FORCE_REVIEW=false
# limites opcionais
EXTERNAL_TIMEOUT_MS=600000
MAX_DIFF_BYTES=2097152
REPORTS_DIR=reports
REVIEW_STATE_FILE=.review-state.json
